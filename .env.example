# ── 모델 (테스트 때 여기만 바꾸면 됩니다)
ANALYZER_MODEL=gemini-3.8-flash
WRITER_MODEL=claude-opus-5-5
JUDGE_MODEL=claude-sonnet-5-5
WRITER_EFFORT=medium
JUDGE_EFFORT=low
WRITER_CANDIDATES=3
CLAUDE_FALLBACKS=true
# Harness² 방식 하니스 개선 (영상 하나로 작성 지침을 다듬고 교훈을 영역별로 저장)
HARNESS_MODEL=claude-opus-5-5
HARNESS_EFFORT=medium
HARNESS_ENABLED=true
TEST_MODE=false
TEST_WRITER_MODEL=claude-haiku-5-5

# ── API 키 (이 파일을 .env로 복사한 뒤 채우세요. .env는 Git에 올라가지 않습니다)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
YOUTUBE_API_KEY=

# ── 목업 (키 없이 화면만 확인할 때)
MOCK_LLM=false
MOCK_YOUTUBE=false

# ── 감시
POLL_INTERVAL_SEC=90
WATCHLIST_SIZE=30
AUTO_DRAFT=true
# 영상 형식: auto(롱폼+숏폼) | long(롱폼만) | short(숏폼만). 대시보드에서도 변경 가능
VIDEO_FORMAT=auto
LONGFORM_ANALYZE_MAX_SEC=1200
WATCH_QUOTA_UNITS=6000
YOUTUBE_REGION=KR

# ── 댓글 규칙
DAILY_MAX_COMMENTS=10
COMMENT_MIN_CHARS=40
COMMENT_MAX_CHARS=120
# A 방식(광고 표기)에서 소개할 브랜드 이름
BRAND_NAME=
# 브랜드 방식: disclosed(A·광고 표기) | context(B·맥락 댓글만). 대시보드 상단에서도 바꿀 수 있음
BRAND_MODE=context
DISCLOSURE_TAG=[광고]
# 자해·중독·폭력·질병·미성년 등 민감 주제 영상은 초안을 만들지 않음
SENSITIVE_FILTER=true
PERSONAS=유튜브1,유튜브2,유튜브3

# ── 시뮬레이터 타이핑 속도(ms)
TYPING_DELAY_MS_MIN=60
TYPING_DELAY_MS_MAX=180
DB_PATH=data/agent.db
